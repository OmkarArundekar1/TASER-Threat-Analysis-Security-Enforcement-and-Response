<!-- RULE 3 : Suspicious Process Execution -->
<!-- Renumbered 100003 -> 100511: original ID collided with "local,"
     group's "Ignore successful sudo" rule; never fired until this fix.
     Mitre T1105 (Ingress Tool Transfer): wget/curl are canonical
     tooling for pulling a payload onto a host post-compromise. Caveat
     (see MITRE_MAPPING.md): matching bare "wget|curl" is a legitimate-
     use-heavy pattern -- the technique label describes the literal
     behavior, it does not by itself mean this specific invocation was
     malicious (threat qualification, not MITRE mapping, decides that). -->
<group name="local,syslog,process">

  <rule id="100511" level="12">

    <match>wget|curl</match>

    <description>Suspicious Process with External Connection detected</description>
    <mitre>
      <id>T1105</id>
    </mitre>

  </rule>

</group>
<group name="custom_attacks">

  <rule id="100100" level="10">
    <match>LOGIN_FAIL</match>
    <description>Login failure detected</description>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>

  <rule id="100200" level="12">
    <match>\[LOGIN_ATTACK\]</match>
    <description>Brute Force Attack Detected</description>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>

  <!-- Deliberately unmapped -- see 210012 above; same synthetic,
       behaviorally-unspecified "INVENTORY" label. -->
  <rule id="100300" level="10">
    <match>INVENTORY accessed</match>
    <description>Inventory Access</description>
  </rule>

  <!-- Renumbered 100004 -> 100512: original ID collided with "local,"
       group's "Ignore checksum changes" rule; never fired until this
       fix. Deliberately left unmapped -- see 210012 above. -->
  <rule id="100512" level="12">
    <match>\[INVENTORY_ABUSE\]</match>
    <description>Inventory Abuse Attack</description>
  </rule>

  <!-- Renumbered 100005 -> 100513: original ID collided with "local,"
       group's "Ignore file deletions" rule; never fired until this
       fix. Mitre T1499.002, same rationale as 210013 above (this is
       the same detection pattern, duplicated content, distinct ID). -->
  <rule id="100513" level="13">
    <match>SLOW endpoint</match>
    <description>Possible DoS Behavior</description>
    <mitre>
      <id>T1499.002</id>
    </mitre>
  </rule>

</group>
<!-- /var/ossec/etc/rules/local_rules.xml -->

<!-- Renumbered 100500 -> 100514 and 100501 -> 100515: both collided
     with "suricata_custom,"'s nmap/autostart rules (defined earlier in
     this file, also 100500/100501) -- meaning these two noise-
     suppression rules were NEVER active, and dpkg install/configure
     events (if_sid 2902/2904) have been reaching the pipeline as
     unsuppressed noise this entire time despite the operator's
     evident intent to filter them (this is exactly why 2902/2904
     appear in mitre_rule_registry.py's list of currently-unmapped lab
     rule IDs -- they were never actually being ignored). -->
<group name="local,ignore,">

  <rule id="100514" level="0">
      <if_sid>2902</if_sid>
      <description>Ignore dpkg installed events</description>
  </rule>

  <rule id="100515" level="0">
      <if_sid>2904</if_sid>
      <description>Ignore dpkg configuration events</description>
  </rule>

</group>
