# ...but not essential frontend build/config manifests
!package.json
!package-lock.json
!tsconfig.json
!tsconfig.*.json

# ...nor CYUKTI's experiment-recording schema/example and benchmark
# reference results (real, intentionally-committed source/reference
# data, not generated telemetry) -- see isfcr/CYUKTI/experiments/README.md
!isfcr/CYUKTI/experiments/schema.json
!isfcr/CYUKTI/experiments/examples/*.json
!isfcr/CYUKTI/experiments/records/*.json
!isfcr/CYUKTI/backend/benchmarks/results/*.json

# ...nor CYUKTI's independent evaluation framework: the scenario
# registry, the raw evidence backing each ground-truth dataset, the
# reproducible evaluation run artifacts, and the human review queues
# -- all real, intentionally-committed data, not generated telemetry.
# See isfcr/CYUKTI/review/evaluation_implementation_report.md.
!isfcr/CYUKTI/evaluation/scenarios/*.json
!isfcr/CYUKTI/evaluation/ground_truth/raw/*.json
!isfcr/CYUKTI/evaluation/results/*.json
!isfcr/CYUKTI/evaluation/review/*.csv

